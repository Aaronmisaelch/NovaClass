# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca debe subirse al control de versiones.

# --- Firebase (cliente) ---
# Firebase Console → Configuración del proyecto → General → Tus apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (servidor) ---
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Pega la private_key completa del JSON, entre comillas, conservando los \n
FIREBASE_ADMIN_PRIVATE_KEY=

# --- App ---
# URL pública de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000
