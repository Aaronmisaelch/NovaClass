# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca debe subirse al control de versiones.
# En Vercel, cada una de estas variables debe cargarse en:
# Project Settings → Environment Variables

# --- Variables públicas del cliente (expuestas al navegador) ---
# Firebase Console → Configuración del proyecto → General → Tus apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu_auth_domain_aqui
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_project_id_aqui
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id_aqui
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id_aqui

# --- Variables privadas del servidor (Firebase Admin, nunca expuestas al navegador) ---
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_ADMIN_PROJECT_ID=tu_admin_project_id_aqui
FIREBASE_ADMIN_CLIENT_EMAIL=tu_admin_client_email_aqui
# Pega la private_key completa del JSON, entre comillas, conservando los \n
FIREBASE_ADMIN_PRIVATE_KEY=tu_admin_private_key_aqui
